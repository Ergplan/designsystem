{
  "name": "ergos-harmony",
  "version": "1.3.0",
  "description": "ergOS Harmony design system: design tokens, the eg- component kit (harmony.css), the window.ErgOS runtime, component previews with usage guidelines, and the jouleWise logo",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ergplan/designsystem.git"
  },
  "exports": {
    "./harmony.css": "./design-system/harmony.css",
    "./harmony.js": "./design-system/harmony.js",
    "./tokens.css": "./design-system/tokens/tokens.css",
    "./tokens": "./design-system/tokens/tokens.js",
    "./design-system/*": "./design-system/*"
  },
  "files": [
    "design-system"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node tools/build-design-system.mjs",
    "build:ds": "node tools/build-design-system.mjs",
    "test": "node --test test/*.test.mjs",
    "demo": "node tools/serve.mjs"
  }
}
